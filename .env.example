# =====================================================================
# Maison Atelier — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env (it is git-ignored).
# =====================================================================

# ---- Database (PostgreSQL) ----
# Local (docker-compose): postgresql://maison:maison@localhost:5432/maison
# Or use a hosted Postgres (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://maison:maison@localhost:5432/maison?schema=public"

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to your client id to show the "Continue with Google" button on the login page
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ---- Stripe ----
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Webhook signing secret (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---- Payments (optional alternative) ----
# Razorpay (Indian payments). Leave blank to disable.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Public Stripe key is referenced above as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
